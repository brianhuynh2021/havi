{
  "name": "havi-platform",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "lint:web": "npm run lint --workspace web",
    "test:web": "npm run test --workspace web",
    "generate:api": "npm run generate:api --workspace web",
    "dev:api": "cd apps/backend && uv run uvicorn api.main:app --reload --port 8000",
    "test:api": "cd apps/backend && uv run pytest",
    "lint:api": "cd apps/backend && uv run ruff check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migrate": "cd apps/backend && uv run alembic upgrade head"
  }
}

# Havi backend environment variables.
# The frontend must never receive any variable from this file.
# Copy to .env and fill real values. .env is gitignored.

HAVI_ENV=local
HAVI_DEBUG=true

# Allowed origins for apps/web, comma-separated.
HAVI_CORS_ORIGINS=http://localhost:3000

# Base URL for apps/web. OAuth callbacks redirect browsers back to this URL.
# This is separate from CORS_ORIGINS[0] because production can have multiple
# origins and list ordering is not a contract.
HAVI_WEB_BASE_URL=http://localhost:3000

# Data and queue.
HAVI_DATABASE_URL=postgresql+psycopg://havi:havi@localhost:5432/havi
HAVI_REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible). The API stores metadata; clients upload
# directly to storage.
HAVI_MEDIA_BUCKET=havi-media
HAVI_MEDIA_PUBLIC_URL=http://localhost:9000/havi-media
HAVI_MEDIA_ENDPOINT_URL=http://localhost:9000
# Public S3/MinIO endpoint used inside presigned upload/download URLs.
HAVI_MEDIA_EXTERNAL_ENDPOINT_URL=http://localhost:9000
HAVI_MEDIA_ACCESS_KEY=minioadmin
HAVI_MEDIA_SECRET_KEY=minioadmin
HAVI_MEDIA_REGION=us-east-1
HAVI_MEDIA_UPLOAD_TTL_SECONDS=900
HAVI_MEDIA_DOWNLOAD_TTL_SECONDS=900
HAVI_MEDIA_MAX_UPLOAD_BYTES=26214400

# Auth.
HAVI_JWT_SECRET=change-me
HAVI_JWT_ALGORITHM=HS256
HAVI_ACCESS_TOKEN_TTL_MINUTES=60
HAVI_REFRESH_TOKEN_TTL_DAYS=30
HAVI_OTP_TTL_SECONDS=300
HAVI_OTP_RESEND_COOLDOWN_SECONDS=30
HAVI_OTP_MAX_ATTEMPTS=5

# Password reset email. `debug` is local-only; staging/production must configure
# SMTP or the backend refuses to start.
HAVI_EMAIL_PROVIDER=debug
HAVI_EMAIL_FROM=
HAVI_SMTP_HOST=
HAVI_SMTP_PORT=465
HAVI_SMTP_USERNAME=
HAVI_SMTP_PASSWORD=
HAVI_SMTP_USE_TLS=true
HAVI_SMTP_TIMEOUT_SECONDS=10

# Platform token encryption key. Only the backend decrypts platform tokens.
# Generate a new key:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes stored platform tokens unreadable; users must reconnect
# their channels.
HAVI_TOKEN_ENCRYPTION_KEY=

# Local mock LLM. This lets development/test runs create drafts without model
# spend. Set false only when testing a real model provider.
# True is forbidden in staging/production.
HAVI_USE_MOCK_LLM=true

# Local fake publisher. This exercises the publishing flow without sending posts
# to Facebook. Set false only when intentionally publishing through real channels.
# True is forbidden in staging/production.
HAVI_USE_FAKE_PUBLISHER=true

# Disable rate limits. Use only for local tests. True is forbidden in
# staging/production because it silently removes brute-force and runaway-script
# protection.
HAVI_DISABLE_RATE_LIMIT=false

# LLM multi-provider. Gemini is preferred; Anthropic/OpenAI are fallbacks.
# Production prompts live in the backend and are never bundled into the frontend.
# Providers with empty keys are skipped by the router.
HAVI_GEMINI_API_KEY=
HAVI_GEMINI_MODEL=gemini-2.5-flash
HAVI_ANTHROPIC_API_KEY=
HAVI_ANTHROPIC_MODEL=claude-sonnet-5
HAVI_OPENAI_API_KEY=
HAVI_OPENAI_MODEL=gpt-5

# Platform OAuth. See docs/handoff/DEPLOYMENT.md for Facebook dashboard steps:
# App Domains, Redirect URI, Use cases, and Configuration.
HAVI_FACEBOOK_CLIENT_ID=
HAVI_FACEBOOK_CLIENT_SECRET=
# Must match the Facebook "Valid OAuth Redirect URIs" value exactly.
# Meta enforces HTTPS, so localhost OAuth needs a tunnel.
HAVI_FACEBOOK_REDIRECT_URI=https://replace-with-your-domain/connections/facebook/callback
# Facebook Login for Business Configuration ID. Leave empty for classic Facebook
# Login, where the adapter sends scope instead of config_id.
HAVI_FACEBOOK_CONFIG_ID=
HAVI_GOOGLE_CLIENT_ID=
HAVI_GOOGLE_CLIENT_SECRET=
HAVI_ZALO_CLIENT_ID=
HAVI_ZALO_CLIENT_SECRET=
